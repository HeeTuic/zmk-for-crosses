#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layers (os números do trackball em crosses_right.overlay usam os mesmos índices)
#define BASE   0
#define PONT   1
#define NUM    2
#define FUNC   3
#define SCROLL 4
#define FLUXO  5
#define MOUSE  6
#define SNIPE  7

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        // Espaço/Ctrl: igual ao &mt, mas só vira Ctrl depois de 150 ms sem digitar.
        // Evita ctrl+letra em rolagens rápidas e preserva o <leader> (Espaço) do LazyVim.
        // Fica só aqui: no Shift do Backspace isso transformaria um Shift rápido em Backspace.
        spc_ctrl: spc_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Polegar esquerdo externo: toque = pontuação sticky (como antes), segurar = Fluxo
        slmo: slmo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&sl>;
        };
    };

    macros {
        // herdr: prefixo ctrl+a seguido da tecla da ação (&hx C = nova aba)
        ZMK_MACRO1(hx,
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(A)>, <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>;
        )

        // Acento por tecla morta do layout Brazilian – Pro (&acc SQT C = ç)
        ZMK_MACRO2(acc,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>, <&macro_param_2to1>, <&kp MACRO_PLACEHOLDER>;
        )

        ZMK_MACRO(m_cao,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp SQT &kp C &kp LS(GRAVE) &kp A &kp O>;
        )

        ZMK_MACRO(m_oes,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LS(GRAVE) &kp O &kp E &kp S>;
        )
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp DELETE            &mkp RCLK            &kp Y                 &kp O               &kp X               &mkp LCLK            &kp F             &kp C                  &kp L                      &kp P    &kp Q  &none
&mt LS(LALT) LC(A)    &kp H                &kp I                 &kp E               &kp A               &kp U                &kp D             &kp S                  &kp T                      &kp N    &kp R  &kp TAB
&to NUM               &kp Z                &sl FUNC              &kp J               &kp K               &mo SCROLL           &kp W             &kp G                  &kp M                      &kp B    &kp V  &caps_word
                                                        &slmo FLUXO PONT     &lt NUM ESCAPE     &spc_ctrl LEFT_CONTROL SPACE  &mt RIGHT_SHIFT BACKSPACE  &mt LEFT_ALT ENTER    &sk LEFT_GUI
            >;
        };

        Pontuacao {
            display-name = "Pontuacao";
            bindings = <
&none             &kp LS(N3)           &kp LS(N6)            &kp LS(N4)          &kp SQT             &kp LS(N5)           &kp LS(GRAVE)     &kp LS(N2)             &kp LS(EQUAL)              &kp SLASH    &kp BACKSLASH  &kp KP_ENTER
&kp LEFT_BRACKET  &kp MINUS            &kp LS(LEFT_BRACKET)  &kp LS(N9)          &kp LS(SQT)         &kp LS(COMMA)        &kp LS(N1)        &kp COMMA              &kp DOT                    &kp SEMICOLON  &kp EQUAL  &kp RIGHT_BRACKET
&none             &kp LS(MINUS)        &kp LS(RIGHT_BRACKET) &kp LS(N0)          &kp GRAVE           &kp LS(DOT)          &kp LS(SLASH)     &kp LS(SEMICOLON)      &kp LS(BACKSLASH)          &kp LS(N8)  &kp LS(N7)  &none
                                                        &none                &none               &kp LEFT_CONTROL      &kp BACKSPACE            &kp LEFT_ALT          &none
            >;
        };

        // Setas na esquerda + numpad na direita. &to NUM no base entra; a mesma tecla aqui volta.
        NumericaSetas {
            display-name = "NumSetas";
            bindings = <
&none     &none         &kp LA(LEFT)       &kp PG_DN        &kp PG_UP         &kp LA(RIGHT)  &none          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none     &none
&none     &kp HOME      &sk LEFT_CONTROL   &kp LEFT_ARROW   &kp RIGHT_ARROW   &kp END        &kp NUMBER_0   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &none     &none
&to BASE  &kp DELETE    &none              &kp DOWN_ARROW   &kp UP_ARROW      &none          &kp COMMA      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT   &none
                                           &none            &none             &none          &sk LEFT_SHIFT &sk LEFT_ALT  &sk RIGHT_GUI
            >;
        };

        // &sl FUNC + 1 tecla: acentos (esq.), F-keys e mídia (dir.), sistema nos polegares
        Funcionalidade {
            display-name = "Func";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3          &bt BT_CLR          &none              &kp F12   &kp F7  &kp F8    &kp F9  &kp C_VOL_UP  &kp C_PP
&sys_reset    &acc SQT A        &acc SQT E        &acc LS(N6) E         &acc LS(GRAVE) A    &acc LS(GRAVE) O   &kp F10   &kp F4  &kp F5    &kp F6  &kp C_VOL_DN  &kp C_NEXT
&bootloader   &acc SQT C        &none             &m_cao                &m_oes              &acc GRAVE A       &kp F11   &kp F1  &kp F2    &kp F3  &kp C_MUTE    &kp C_PREV
                                &none             &kp C_BRI_DN          &kp C_BRI_UP        &kp LG(LS(N4))     &kp LG(LS(N5))     &studio_unlock
            >;
        };

        // Segurando &mo SCROLL, o trackball rola (scroll-layers no overlay)
        Scroll {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Segurar o polegar esquerdo externo. Esquerda = herdr (ctrl+a …); direita = AeroSpace,
        // com os workspaces na mesma posição dos números do layer NumSetas (Fluxo + 5 = alt-5).
        Fluxo {
            display-name = "Fluxo";
            bindings = <
&hx LS(SLASH)  &hx C        &hx P        &hx N        &hx G        &hx F         &kp LA(S)        &kp LA(N7)  &kp LA(N8)  &kp LA(N9)  &kp LA(W)  &kp LC(A)
&trans         &hx Z        &hx O        &hx LS(A)    &hx A        &hx W         &kp LA(N0)       &kp LA(N4)  &kp LA(N5)  &kp LA(N6)  &kp LA(R)  &hx V
&trans         &hx LC(G)    &hx LC(D)    &hx LC(P)    &hx LC(S)    &hx LC(R)     &kp LS(LA(I))    &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &kp LA(M)  &hx MINUS
                                         &trans       &trans       &trans        &trans           &trans      &trans
            >;
        };

        // Automouse: ativa ao mexer no trackball. Cliques na home row esquerda.
        Mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans      &trans     &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mo SNIPE   &mkp RCLK  &mkp MCLK  &mkp LCLK  &mo SCROLL   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans     &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
                               &trans     &trans     &trans       &trans  &trans  &trans
            >;
        };

        // Segurando &mo SNIPE (layer Mouse), o trackball fica lento e preciso (snipe-layers)
        Snipe {
            display-name = "Snipe";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
