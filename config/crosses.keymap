#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layers (os números do trackball em crosses_right.overlay usam os mesmos índices)
#define BASE   0
#define PONT   1
#define NUM    2
#define FUNC   3
// O driver do trackball decide rolar/precisão pelo layer ATIVO MAIS ALTO: Scroll e Snipe
// precisam ficar acima do Mouse (automouse), senão o Mouse ligado esconde os dois.
#define MOUSE  4
#define FLUXO  5
#define SCROLL 6
#define SNIPE  7

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        // Espaço/Ctrl: igual ao &mt, mas só vira Ctrl depois de 150 ms sem digitar.
        // Evita ctrl+letra em rolagens rápidas e preserva o <leader> (Espaço) do LazyVim.
        // Fica só aqui: no Shift do Backspace isso transformaria um Shift rápido em Backspace.
        spc_ctrl: spc_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // OTA: reinicia no bootloader Adafruit em modo atualização por Bluetooth (GPREGRET = 0xA8,
        // DFU_MAGIC_OTA_RESET). Nome do nó com até 8 caracteres porque também roda na metade periférica.
        ota: otadfu {
            compatible = "zmk,behavior-reset";
            #binding-cells = <0>;
            type = <0xA8>;
            display-name = "OTA";
        };

        // Polegar esquerdo externo: toque = pontuação sticky (como antes), segurar = Fluxo
        slmo: slmo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&sl>;
        };
    };

    macros {
        // herdr: prefixo ctrl+a seguido da tecla da ação (&hx C = nova aba)
        ZMK_MACRO1(hx,
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LC(A)>, <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>;
        )


        ZMK_MACRO(m_ao,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LS(GRAVE) &kp A &kp O>;
        )

        ZMK_MACRO(m_oes,
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LS(GRAVE) &kp O &kp E &kp S>;
        )
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp DELETE            &kp LC(A)            &kp Y                 &kp O               &kp X               &kp LG(C)            &kp F             &kp C                  &kp L                      &kp P    &kp Q  &key_repeat
&kp LC(UP)            &kp H                &kp I                 &kp E               &kp A               &kp U                &kp D             &kp S                  &kp T                      &kp N    &kp R  &kp TAB
&to NUM               &kp Z                &sl FUNC              &kp J               &kp K               &kp LG(V)            &kp W             &kp G                  &kp M                      &kp B    &kp V  &caps_word
                                                        &slmo FLUXO PONT     &lt NUM ESCAPE     &spc_ctrl LEFT_CONTROL SPACE  &mt RIGHT_SHIFT BACKSPACE  &mt LEFT_ALT ENTER    &sk LEFT_GUI
            >;
        };

        Pontuacao {
            display-name = "Pontuacao";
            bindings = <
&none             &kp LS(N3)           &kp LS(N6)            &kp LS(N4)          &kp SQT             &kp LS(N5)           &kp LS(GRAVE)     &kp LS(N2)             &kp LS(EQUAL)              &kp SLASH    &kp BACKSLASH  &kp KP_ENTER
&kp LEFT_BRACKET  &kp MINUS            &kp LS(LEFT_BRACKET)  &kp LS(N9)          &kp LS(SQT)         &kp LS(COMMA)        &kp LS(N1)        &kp COMMA              &kp DOT                    &kp SEMICOLON  &kp EQUAL  &kp RIGHT_BRACKET
&none             &kp LS(MINUS)        &kp LS(RIGHT_BRACKET) &kp LS(N0)          &kp GRAVE           &kp LS(DOT)          &kp LS(SLASH)     &kp LS(SEMICOLON)      &kp LS(BACKSLASH)          &kp LS(N8)  &kp LS(N7)  &none
                                                        &none                &none               &kp LEFT_CONTROL      &kp BACKSPACE            &kp LEFT_ALT          &none
            >;
        };

        // Setas na esquerda + numpad na direita. &to NUM no base entra; a mesma tecla aqui volta.
        NumericaSetas {
            display-name = "NumSetas";
            bindings = <
&none     &none         &kp LA(LEFT)       &kp PG_DN        &kp PG_UP         &kp LA(RIGHT)  &none          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none     &none
&none     &kp HOME      &sk LEFT_CONTROL   &kp LEFT_ARROW   &kp RIGHT_ARROW   &kp END        &kp NUMBER_0   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &none     &none
&to BASE  &kp DELETE    &none              &kp DOWN_ARROW   &kp UP_ARROW      &none          &kp COMMA      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT   &none
                                           &none            &none             &none          &sk LEFT_SHIFT &sk LEFT_ALT  &sk RIGHT_GUI
            >;
        };

        // &sl FUNC + 1 tecla: ão/ões e mídia na mão esquerda (descanso), F-keys na direita, sistema nos polegares.
        // reset/boot nos dois cantos externos: em teclado dividido cada um só age na metade em que é apertado.
        Funcionalidade {
            display-name = "Func";
            bindings = <
&ota          &bt BT_CLR        &bt BT_SEL 3      &bt BT_SEL 2          &bt BT_SEL 1        &bt BT_SEL 0       &kp F12   &kp F7  &kp F8    &kp F9  &none         &ota
&sys_reset    &kp C_VOL_DN      &kp C_VOL_UP      &m_oes                &m_ao               &kp C_MUTE         &kp F10   &kp F4  &kp F5    &kp F6  &none         &sys_reset
&bootloader   &kp C_PREV        &none             &kp C_PP              &kp C_NEXT          &kp LC(LA(LG(LS(M)))) &kp F11   &kp F1  &kp F2    &kp F3  &none         &bootloader
                                &none             &kp C_BRI_DN          &kp C_BRI_UP        &kp LG(LS(N4))     &kp LG(LS(N5))     &studio_unlock
            >;
        };

        // Mouse: liga ao mexer no trackball (zip_temp_layer no overlay). Só os polegares esquerdos mudam:
        // clique direito · Scroll (segurar) · clique. Qualquer outra tecla desliga o layer e digita normal.
        Mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &mkp RCLK  &mo SCROLL  &mkp LCLK  &trans  &trans  &trans
            >;
        };

        // Segurar o polegar esquerdo externo. Esquerda = herdr (ctrl+a …): coluna externa tarefas/captura/mapa,
        // abas e splits em cima, panes nas mesmas posições das setas do NumSetas. Polegares direitos = agente ▶ ◀ e notificado.
        // Direita = AeroSpace via ctrl+alt+⌘ (alt+N fica para o herdr),
        // com os workspaces na mesma posição dos números do layer NumSetas (Fluxo + 5 = alt-5).
        Fluxo {
            display-name = "Fluxo";
            bindings = <
&hx LC(T)      &hx C        &hx P        &hx N        &hx V        &hx MINUS     &kp LC(LA(LG(S)))        &kp LC(LA(LG(N7)))  &kp LC(LA(LG(N8)))  &kp LC(LA(LG(N9)))  &kp LC(LA(LG(W)))  &hx F
&hx LC(N)      &hx LC(D)    &hx LC(S)    &hx H        &hx L        &hx Z         &kp LC(LA(LG(N0)))       &kp LC(LA(LG(N4)))  &kp LC(LA(LG(N5)))  &kp LC(LA(LG(N6)))  &kp LC(LA(LG(R)))  &hx W
&hx LC(K)      &hx LC(G)    &hx LC(P)    &hx J        &hx K        &hx LC(R)     &kp LC(LA(LG(M)))        &kp LC(LA(LG(N1)))  &kp LC(LA(LG(N2)))  &kp LC(LA(LG(N3)))  &kp LC(LA(LG(LS(I))))  &hx G
                                         &trans       &trans       &trans        &hx A            &hx LS(A)   &hx O
            >;
        };

        // Segurando &mo SCROLL (tecla do E no layer Mouse, onde era o clique do meio), o trackball rola (scroll-layers no overlay)
        Scroll {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Segurando &mo SNIPE (layer Mouse), o trackball fica lento e preciso (snipe-layers)
        Snipe {
            display-name = "Snipe";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
